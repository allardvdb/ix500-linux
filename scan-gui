#!/usr/bin/env python3
"""scan-gui - Minimal desktop front-end for Fujitsu ScanSnap scanners.

Three choices, then scan:

  Pages    Single page - one scan session becomes the document.
           Multi page  - keep scanning pages; they combine into one PDF.

  Color    Color       - keep every page in color.
           Grayscale   - convert every page to grayscale.
           Auto        - detect color vs grayscale per page.

  Send to  Paperless   - deliver through the configured Paperless/folder pipeline.
           NAPS2       - open the finished PDF in the NAPS2 desktop app.
           Raw Tiff    - developer-only (shown with `--dev`); save the pages as
                         untouched scanner TIFFs for the tuning corpus.

A scan is triggered either by the on-screen button or by the hardware scanner
button. The scanner button reaches the running window through a second
`scan-gui --scan` invocation (the app is a single instance), so pressing the
scanner button does exactly what pressing the on-screen button would: start a
scan when idle, or add the next page while a multi-page document is in flow.

All scanning is done by the `scan-doc` shell script; this file is only the
window, the choices, and the flow between scan pages.
"""

import os
import shutil
import signal
import subprocess
import sys
import tempfile
import threading

import gi

gi.require_version("Gtk", "4.0")
from gi.repository import Gio, GLib, Gtk

SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
SCAN_DOC = os.path.join(SCRIPT_DIR, "scan-doc")

# scan-lib.sh prints this when it could not determine any page's orientation.
ORIENTATION_UNDETERMINED_MARKER = "orientation-undetermined"

TARGET_LABELS = {"paperless": "Paperless", "naps2": "NAPS2", "raw-tiff": "Raw Tiff"}

# Window states that decide what a scan trigger does.
STATE_IDLE = "idle"            # ready to start a new document
STATE_BUSY = "busy"            # scanning or finishing; triggers are ignored
STATE_AWAITING_NEXT = "next"   # multi-page document in flow; trigger adds a page


class ScanDoc:
    """Drives the `scan-doc` script for one accumulating document."""

    def __init__(self):
        self.workdir = tempfile.mkdtemp(prefix="scan-gui-")
        self.pages = 0
        # True once any batch's orientation was determined; stays False when the
        # scanner output is too sparse for orientation detection on every page.
        self.orientation_known = False

    def capture(self, color_mode, raw=False):
        argv = [SCAN_DOC, "capture", self.workdir, "--color", color_mode]
        if raw:
            argv.append("--raw")
        result = _run(argv)
        if result.ok:
            self.pages += 1
            if ORIENTATION_UNDETERMINED_MARKER not in result.output:
                self.orientation_known = True
        return result

    def finalize(self, target):
        return _run([SCAN_DOC, "finalize", self.workdir, "--target", target])

    def discard(self):
        shutil.rmtree(self.workdir, ignore_errors=True)


class CommandResult:
    def __init__(self, ok, output):
        self.ok = ok
        self.output = output


def _run(argv):
    try:
        proc = subprocess.run(argv, capture_output=True, text=True)
        return CommandResult(proc.returncode == 0, (proc.stdout or "") + (proc.stderr or ""))
    except Exception as error:  # noqa: BLE001 - surface any launch failure in the UI
        return CommandResult(False, str(error))


def run_async(argv_or_callable, on_done):
    """Run work off the UI thread, then deliver the result on the UI thread."""

    def worker():
        result = argv_or_callable() if callable(argv_or_callable) else _run(argv_or_callable)
        GLib.idle_add(on_done, result)

    threading.Thread(target=worker, daemon=True).start()


class ScanWindow(Gtk.ApplicationWindow):
    def __init__(self, app):
        self.dev_mode = getattr(app, "dev_mode", False)
        title = "ScanSnap (dev)" if self.dev_mode else "ScanSnap"
        super().__init__(application=app, title=title)
        self.set_default_size(360, -1)
        self.doc = None
        self.state = STATE_IDLE

        self._page_frame, (self.page_single, self.page_multi) = self._build_choice_section(
            "Pages",
            [("Scan single page", True), ("Scan multi page", False)],
        )
        self._color_frame, (self.color_color, self.color_gray, self.color_auto) = (
            self._build_choice_section(
                "Color",
                [("Color", True), ("Grayscale", False), ("Auto", False)],
            )
        )
        send_options = [("Send to Paperless", True), ("Send to NAPS2", False)]
        if self.dev_mode:
            send_options.append(("Raw Tiff", False))
        self._send_frame, send_buttons = self._build_choice_section("Send to", send_options)
        self.send_paperless, self.send_naps2 = send_buttons[0], send_buttons[1]
        self.send_raw = send_buttons[2] if self.dev_mode else None

        self.scan_button = Gtk.Button(label="Scan")
        self.scan_button.add_css_class("suggested-action")
        self.scan_button.connect("clicked", lambda _b: self.trigger_scan())

        self.finish_button = Gtk.Button(label="Finish")
        self.finish_button.set_visible(False)
        self.finish_button.connect("clicked", lambda _b: self._finalize())

        buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        buttons.append(self.scan_button)
        buttons.append(self.finish_button)
        self.scan_button.set_hexpand(True)

        self.status = Gtk.Label(label="Ready", xalign=0.0)
        self.status.add_css_class("dim-label")

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        root.set_margin_top(16)
        root.set_margin_bottom(16)
        root.set_margin_start(16)
        root.set_margin_end(16)
        root.append(self._page_frame)
        root.append(self._color_frame)
        root.append(self._send_frame)
        root.append(buttons)
        root.append(self.status)
        self.set_child(root)

    def _build_choice_section(self, title, options):
        """Build a titled frame of radio buttons. Returns (frame, buttons)."""
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.set_margin_top(8)
        box.set_margin_bottom(8)
        box.set_margin_start(8)
        box.set_margin_end(8)

        buttons = []
        group = None
        for label, active in options:
            button = Gtk.CheckButton(label=label)
            if group is None:
                group = button
            else:
                button.set_group(group)
            button.set_active(active)
            box.append(button)
            buttons.append(button)

        frame = Gtk.Frame(label=title)
        frame.set_child(box)
        return frame, buttons

    # --- Scan flow -------------------------------------------------------

    def trigger_scan(self):
        """Act on a scan request from the on-screen or hardware button."""
        if self.state == STATE_BUSY:
            self.status.set_text("Still scanning, please wait...")
            return
        if self.state == STATE_IDLE:
            self.doc = ScanDoc()
            self._capture()
        elif self.state == STATE_AWAITING_NEXT:
            self._capture()

    def _color_mode(self):
        if self.color_color.get_active():
            return "color"
        if self.color_gray.get_active():
            return "gray"
        return "auto"

    def _send_target(self):
        if self.send_raw is not None and self.send_raw.get_active():
            return "raw-tiff"
        if self.send_naps2.get_active():
            return "naps2"
        return "paperless"

    def _capture(self):
        self._set_busy("Scanning...")
        color_mode = self._color_mode()
        raw = self._send_target() == "raw-tiff"
        run_async(lambda: self.doc.capture(color_mode, raw), self.on_capture_done)

    def on_capture_done(self, result):
        if not result.ok:
            summary = _capture_error_summary(result.output)
            detail = _capture_error_detail(result.output)
            if self.doc.pages == 0:
                self._fail(summary, detail)
                return
            self._await_next()
            self._show_alert(summary, detail)
            return

        if self.page_multi.get_active():
            self._await_next()
        else:
            self._finalize()

    def _await_next(self):
        self.state = STATE_AWAITING_NEXT
        self.scan_button.set_label("Scan next page")
        self.scan_button.set_sensitive(True)
        self.finish_button.set_visible(True)
        self.finish_button.set_sensitive(True)
        self._color_frame.set_sensitive(True)
        self._send_frame.set_sensitive(True)
        self.status.set_text(
            f"Scanned {self.doc.pages} page(s). Load the next page, then Scan."
        )

    def _finalize(self):
        target = self._send_target()
        if self.doc is not None and not self.doc.orientation_known \
                and target not in ("naps2", "raw-tiff"):
            self._confirm_naps2_fallback(target)
            return
        self._do_finalize(target)

    def _do_finalize(self, target):
        self._set_busy("Finishing...")
        run_async(lambda: self.doc.finalize(target), self.on_finalize_done)

    def _confirm_naps2_fallback(self, target):
        """Orientation could not be detected — offer NAPS2 for a manual look."""
        dialog = Gtk.AlertDialog()
        dialog.set_modal(True)
        dialog.set_message("Couldn't determine page orientation")
        dialog.set_detail(
            "Pages may come out sideways or upside down. Send to NAPS2 to "
            f"review and rotate them by hand instead of {TARGET_LABELS.get(target, target)}?"
        )
        dialog.set_buttons(["Send to NAPS2", f"Keep {TARGET_LABELS.get(target, target)}"])
        dialog.set_default_button(0)
        dialog.set_cancel_button(1)
        dialog.choose(self, None,
                      lambda d, res: self._on_naps2_choice(d, res, target))

    def _on_naps2_choice(self, dialog, result, target):
        try:
            index = dialog.choose_finish(result)
        except GLib.Error:
            index = 1
        self._do_finalize("naps2" if index == 0 else target)

    def on_finalize_done(self, result):
        self.doc = None
        if result.ok:
            self.status.set_text(_last_line(result.output) or "Done.")
            self._set_idle()
        else:
            self._fail("Finishing failed", result.output)

    # --- UI state --------------------------------------------------------

    def _set_busy(self, message):
        self.state = STATE_BUSY
        self.status.set_text(message)
        self.scan_button.set_sensitive(False)
        self.finish_button.set_sensitive(False)
        self._page_frame.set_sensitive(False)
        self._color_frame.set_sensitive(False)
        self._send_frame.set_sensitive(False)

    def _set_idle(self):
        self.state = STATE_IDLE
        self.scan_button.set_label("Scan")
        self.scan_button.set_sensitive(True)
        self.finish_button.set_visible(False)
        self._page_frame.set_sensitive(True)
        self._color_frame.set_sensitive(True)
        self._send_frame.set_sensitive(True)

    def _fail(self, summary, detail):
        if self.doc is not None:
            self.doc.discard()
            self.doc = None
        self.status.set_text(summary)
        self._set_idle()
        self._show_alert(summary, detail)

    def _show_alert(self, summary, detail=""):
        dialog = Gtk.AlertDialog()
        dialog.set_message(summary)
        detail_text = _last_line(detail) or detail.strip()
        if detail_text:
            dialog.set_detail(detail_text)
        dialog.show(self)


def _last_line(text):
    lines = [line for line in (text or "").splitlines() if line.strip()]
    return lines[-1] if lines else ""


def _capture_error_summary(output):
    """Short alert title for a failed capture."""
    text = output or ""
    lower = text.lower()
    if "no scansnap scanner found" in lower or "not connected" in lower \
            or "disconnected" in lower or "invalid argument" in lower:
        return "Scanner not connected"
    if "scanner busy" in lower or "lock" in lower:
        return "Scanner busy"
    if "both the feeder" in lower:
        return "Document in both inputs"
    if "no document detected" in lower or "feeder empty" in lower:
        return "No document detected"
    if "scanner error" in lower or "device i/o" in lower or "cannot load" in lower:
        return "Scanner error"
    return "Scan failed"


def _capture_error_detail(output):
    """Longer alert detail — the most useful line from scan-doc stderr."""
    for line in reversed([line.strip() for line in (output or "").splitlines() if line.strip()]):
        if line.startswith(("Error:", "Scanner error:", "Scanner busy", "No document",
                            "Documents loaded", "Documents in both")):
            return line
        if line.lower().startswith("scanimage:"):
            return line.split(":", 1)[1].strip()
    return _last_line(output)


def _dev_requested(argv=None):
    """True when developer mode was requested on the command line or via env."""
    if os.environ.get("SCAN_GUI_DEV", "").lower() in ("1", "true", "yes"):
        return True
    argv = argv if argv is not None else sys.argv
    return "--dev" in argv or "--debug" in argv


class ScanApp(Gtk.Application):
    def __init__(self):
        super().__init__(
            application_id="com.github.scansnaplinux.ScanGui",
            flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE,
        )
        self.dev_mode = _dev_requested()
        self.add_main_option(
            "scan", ord("s"), GLib.OptionFlags.NONE, GLib.OptionArg.NONE,
            "Trigger a scan in the running window", None,
        )
        self.add_main_option(
            "dev", ord("d"), GLib.OptionFlags.NONE, GLib.OptionArg.NONE,
            "Show developer options (Raw Tiff output)", None,
        )
        self.add_main_option(
            "debug", 0, GLib.OptionFlags.HIDDEN, GLib.OptionArg.NONE,
            "Alias for --dev", None,
        )

    def do_startup(self):
        Gtk.Application.do_startup(self)

        scan_action = Gio.SimpleAction.new("scan", None)
        scan_action.connect("activate", self._on_scan_action)
        self.add_action(scan_action)

        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, self._on_scan_signal)

    def _on_scan_signal(self):
        GLib.idle_add(self._trigger_scan)
        return True

    def _on_scan_action(self, _action, _param):
        GLib.idle_add(self._trigger_scan)

    def _trigger_scan(self):
        window = self.props.active_window or ScanWindow(self)
        window.present()
        window.trigger_scan()
        return False

    def _window_for_launch(self):
        """Open a window, replacing a non-dev one when --dev is requested."""
        window = self.props.active_window
        if window is None:
            return ScanWindow(self)
        if self.dev_mode and not window.dev_mode:
            window.destroy()
            return ScanWindow(self)
        return window

    def do_command_line(self, command_line):
        options = command_line.get_options_dict()
        if options.contains("dev") or options.contains("debug"):
            self.dev_mode = True
        elif _dev_requested(command_line.get_arguments()):
            self.dev_mode = True
        window = self._window_for_launch()
        window.present()
        if options.contains("scan"):
            GLib.idle_add(self._trigger_scan)
        return 0


if __name__ == "__main__":
    ScanApp().run(sys.argv)
