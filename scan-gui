#!/usr/bin/env python3
"""scan-gui - Minimal desktop front-end for the ScanSnap iX1300.

Two choices, then scan:

  Pages    Single page - one scan session becomes the document.
           Multi page  - keep scanning pages; they combine into one PDF.

  Send to  Paperless   - deliver through the configured Paperless/local pipeline.
           NAPS2       - open the finished PDF in the NAPS2 desktop app.

A scan is triggered either by the on-screen button or by the hardware scanner
button. The scanner button reaches the running window through a second
`scan-gui --scan` invocation (the app is a single instance), so pressing the
scanner button does exactly what pressing the on-screen button would: start a
scan when idle, or add the next page while a multi-page document is in flow.

All scanning is done by the `scan-doc` shell script; this file is only the
window, the two choices, and the flow between scan pages.
"""

import os
import shutil
import signal
import subprocess
import tempfile
import threading

import gi

gi.require_version("Gtk", "4.0")
from gi.repository import Gio, GLib, Gtk

SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
SCAN_DOC = os.path.join(SCRIPT_DIR, "scan-doc")

# Window states that decide what a scan trigger does.
STATE_IDLE = "idle"            # ready to start a new document
STATE_BUSY = "busy"            # scanning or finishing; triggers are ignored
STATE_AWAITING_NEXT = "next"   # multi-page document in flow; trigger adds a page


class ScanDoc:
    """Drives the `scan-doc` script for one accumulating document."""

    def __init__(self):
        self.workdir = tempfile.mkdtemp(prefix="scan-gui-")
        self.pages = 0

    def capture(self):
        result = _run([SCAN_DOC, "capture", self.workdir])
        if result.ok:
            self.pages += 1
        return result

    def finalize(self, target):
        return _run([SCAN_DOC, "finalize", self.workdir, "--target", target])

    def discard(self):
        shutil.rmtree(self.workdir, ignore_errors=True)


class CommandResult:
    def __init__(self, ok, output):
        self.ok = ok
        self.output = output


def _run(argv):
    try:
        proc = subprocess.run(argv, capture_output=True, text=True)
        return CommandResult(proc.returncode == 0, (proc.stdout or "") + (proc.stderr or ""))
    except Exception as error:  # noqa: BLE001 - surface any launch failure in the UI
        return CommandResult(False, str(error))


def run_async(argv_or_callable, on_done):
    """Run work off the UI thread, then deliver the result on the UI thread."""

    def worker():
        result = argv_or_callable() if callable(argv_or_callable) else _run(argv_or_callable)
        GLib.idle_add(on_done, result)

    threading.Thread(target=worker, daemon=True).start()


class ScanWindow(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="ScanSnap")
        self.set_default_size(360, -1)
        self.doc = None
        self.state = STATE_IDLE

        self.page_single, self.page_multi = self._build_choice_section(
            "Pages",
            [("Scan single page", True), ("Scan multi page", False)],
        )
        self.send_paperless, self.send_naps2 = self._build_choice_section(
            "Send to",
            [("Send to Paperless", True), ("Send to NAPS2", False)],
        )

        self.scan_button = Gtk.Button(label="Scan")
        self.scan_button.add_css_class("suggested-action")
        self.scan_button.connect("clicked", lambda _b: self.trigger_scan())

        self.finish_button = Gtk.Button(label="Finish")
        self.finish_button.set_visible(False)
        self.finish_button.connect("clicked", lambda _b: self._finalize())

        buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        buttons.append(self.scan_button)
        buttons.append(self.finish_button)
        self.scan_button.set_hexpand(True)

        self.status = Gtk.Label(label="Ready", xalign=0.0)
        self.status.add_css_class("dim-label")

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        root.set_margin_top(16)
        root.set_margin_bottom(16)
        root.set_margin_start(16)
        root.set_margin_end(16)
        root.append(self._page_frame)
        root.append(self._send_frame)
        root.append(buttons)
        root.append(self.status)
        self.set_child(root)

    def _build_choice_section(self, title, options):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.set_margin_top(8)
        box.set_margin_bottom(8)
        box.set_margin_start(8)
        box.set_margin_end(8)

        buttons = []
        group = None
        for label, active in options:
            button = Gtk.CheckButton(label=label)
            if group is None:
                group = button
            else:
                button.set_group(group)
            button.set_active(active)
            box.append(button)
            buttons.append(button)

        frame = Gtk.Frame(label=title)
        frame.set_child(box)
        if title == "Pages":
            self._page_frame = frame
        else:
            self._send_frame = frame
        return buttons

    # --- Scan flow -------------------------------------------------------

    def trigger_scan(self):
        """Act on a scan request from the on-screen or hardware button."""
        if self.state == STATE_BUSY:
            self.status.set_text("Still scanning, please wait...")
            return
        if self.state == STATE_IDLE:
            self.doc = ScanDoc()
            self._capture()
        elif self.state == STATE_AWAITING_NEXT:
            self._capture()

    def _capture(self):
        self._set_busy("Scanning...")
        run_async(self.doc.capture, self.on_capture_done)

    def on_capture_done(self, result):
        if not result.ok and self.doc.pages == 0:
            self._fail("Scan failed", result.output)
            return

        if not result.ok:
            self.status.set_text("Nothing added — load a page and try again.")

        if self.page_multi.get_active():
            self._await_next()
        else:
            self._finalize()

    def _await_next(self):
        self.state = STATE_AWAITING_NEXT
        self.scan_button.set_label("Scan next page")
        self.scan_button.set_sensitive(True)
        self.finish_button.set_visible(True)
        self.finish_button.set_sensitive(True)
        self._send_frame.set_sensitive(True)
        self.status.set_text(
            f"Scanned {self.doc.pages} page(s). Load the next page, then Scan."
        )

    def _finalize(self):
        target = "naps2" if self.send_naps2.get_active() else "paperless"
        self._set_busy("Finishing...")
        run_async(lambda: self.doc.finalize(target), self.on_finalize_done)

    def on_finalize_done(self, result):
        self.doc = None
        if result.ok:
            self.status.set_text(_last_line(result.output) or "Done.")
            self._set_idle()
        else:
            self._fail("Finishing failed", result.output)

    # --- UI state --------------------------------------------------------

    def _set_busy(self, message):
        self.state = STATE_BUSY
        self.status.set_text(message)
        self.scan_button.set_sensitive(False)
        self.finish_button.set_sensitive(False)
        self._page_frame.set_sensitive(False)
        self._send_frame.set_sensitive(False)

    def _set_idle(self):
        self.state = STATE_IDLE
        self.scan_button.set_label("Scan")
        self.scan_button.set_sensitive(True)
        self.finish_button.set_visible(False)
        self._page_frame.set_sensitive(True)
        self._send_frame.set_sensitive(True)

    def _fail(self, summary, detail):
        if self.doc is not None:
            self.doc.discard()
            self.doc = None
        self.status.set_text(summary)
        self._set_idle()
        dialog = Gtk.AlertDialog()
        dialog.set_message(summary)
        detail_text = _last_line(detail) or detail.strip() or "Unknown error"
        dialog.set_detail(detail_text)
        dialog.show(self)


def _last_line(text):
    lines = [line for line in (text or "").splitlines() if line.strip()]
    return lines[-1] if lines else ""


class ScanApp(Gtk.Application):
    def __init__(self):
        super().__init__(
            application_id="com.github.ix500linux.ScanGui",
            flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE,
        )
        self.add_main_option(
            "scan", ord("s"), GLib.OptionFlags.NONE, GLib.OptionArg.NONE,
            "Trigger a scan in the running window", None,
        )

    def do_startup(self):
        Gtk.Application.do_startup(self)

        scan_action = Gio.SimpleAction.new("scan", None)
        scan_action.connect("activate", self._on_scan_action)
        self.add_action(scan_action)

        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, self._on_scan_signal)

    def _on_scan_signal(self):
        GLib.idle_add(self._trigger_scan)
        return True

    def _on_scan_action(self, _action, _param):
        GLib.idle_add(self._trigger_scan)

    def _trigger_scan(self):
        window = self.props.active_window or ScanWindow(self)
        window.present()
        window.trigger_scan()
        return False

    def do_command_line(self, command_line):
        options = command_line.get_options_dict()
        window = self.props.active_window or ScanWindow(self)
        window.present()
        if options.contains("scan"):
            GLib.idle_add(self._trigger_scan)
        return 0


if __name__ == "__main__":
    ScanApp().run(None)
