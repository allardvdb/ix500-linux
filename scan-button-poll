#!/bin/bash
# scan-button-poll - Poll the ScanSnap hardware button and trigger a scan.
# Designed to be started/stopped by udev on USB connect/disconnect

POLL_INTERVAL=0.1
DEBOUNCE=3

# Resolve scan scripts relative to this script's location
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
SCAN_SCRIPT="$SCRIPT_DIR/scan"
SCAN_GUI="$SCRIPT_DIR/scan-gui"
source "$SCRIPT_DIR/scan-lib.sh"

log() {
    echo "[$(date '+%H:%M:%S')] $1"
}

# True when the scan GUI is running and owns its application name, so a button
# press should be forwarded to the window instead of scanning headlessly.
gui_running() {
    if command -v gdbus >/dev/null 2>&1; then
        local owned
        owned=$(gdbus call --session \
            --dest org.freedesktop.DBus \
            --object-path /org/freedesktop/DBus \
            --method org.freedesktop.DBus.NameHasOwner \
            com.github.scansnaplinux.ScanGui 2>/dev/null)
        [ "$owned" = "(true,)" ] && return 0
    fi
    pgrep -f '[s]can-gui' >/dev/null 2>&1
}

# Ask the running GUI to scan. SIGUSR1 is the primary path (reliable from
# systemd); D-Bus action and a second --scan instance are fallbacks.
forward_to_gui() {
    local pid
    pid=$(pgrep -f '[s]can-gui' | head -1)
    if [ -n "$pid" ]; then
        kill -USR1 "$pid" 2>/dev/null && return 0
    fi
    if command -v gdbus >/dev/null 2>&1; then
        gdbus call --session \
            --dest com.github.scansnaplinux.ScanGui \
            --object-path /com/github/scansnaplinux/ScanGui \
            --method org.gtk.Actions.Activate \
            scan '[]' '{}' >/dev/null 2>&1 && return 0
    fi
    "$SCAN_GUI" --scan >/dev/null 2>&1 &
}

# Headless one-button scan (single page + Paperless) with desktop notifications.
# Used only when the GUI is not running.
run_headless_scan() {
    local SCAN_OUTPUT SCAN_OK OUTFILE
    SCAN_OUTPUT=$("$SCAN_SCRIPT" 2>&1) && SCAN_OK=true || SCAN_OK=false
    echo "$SCAN_OUTPUT"

    if [ "$SCAN_OK" = true ]; then
        log "Scan completed successfully"
        # Send clickable desktop notification (in background to not block polling)
        if [ -n "$PAPERLESS_URL" ]; then
            (
                ACTION=$(notify-send -i scanner --action="open=Open in Paperless" \
                    "Scan Complete" "Document uploaded to Paperless" 2>/dev/null)
                [ "$ACTION" = "open" ] && xdg-open "$PAPERLESS_URL" 2>/dev/null
            ) &
        else
            OUTFILE=$(echo "$SCAN_OUTPUT" | grep -oP '(?<=Done: )\S+')
            (
                ACTION=$(notify-send -i scanner --action="open=Open" \
                    "Scan Complete" "Document saved to folder" 2>/dev/null)
                [ "$ACTION" = "open" ] && xdg-open "$OUTFILE" 2>/dev/null
            ) &
        fi
    else
        log "Scan failed"
        (
            ACTION=$(notify-send -u critical -i dialog-error --action="logs=View Logs" \
                "Scan Failed" "Something went wrong during scanning" 2>/dev/null)
            [ "$ACTION" = "logs" ] && xdg-terminal-exec journalctl --user -u scan-button.service -n 50 --no-pager 2>/dev/null
        ) &
    fi
}

# Auto-detect scanner device (fallback when SCANNER_DEVICE is not set)
detect_device() {
    scanimage -L 2>/dev/null | grep -oP "$SCANSNAP_DEVICE_RE" | head -1
}

get_button_state() {
    local output state
    output=$(SCAN_LOCK_TIMEOUT=1 with_scan_lock scanimage --device "$DEVICE" -A 2>/dev/null) || {
        echo "busy"
        return
    }
    state=$(echo "$output" | grep -oP '(?<=--scan\[=\(yes\|no\)\] \[)\w+' || true)
    if [ -z "$state" ]; then
        echo "error"
    else
        echo "$state"
    fi
}

# Scanner device — from env or auto-detect
if [ -n "$SCANNER_DEVICE" ]; then
    DEVICE="$SCANNER_DEVICE"
else
    DEVICE=$(detect_device)
fi
if [ -z "$DEVICE" ]; then
    log "Error: no ScanSnap scanner found"
    exit 1
fi

log "Starting button poll for $DEVICE"

# Wait for scanner to be ready
sleep 2

# Main polling loop
while true; do
    poll_interval=$POLL_INTERVAL
    gui_running && poll_interval=0.5

    button_state=$(get_button_state)

    if [ "$button_state" = "yes" ]; then
        if gui_running; then
            log "Button pressed! Forwarding to GUI..."
            forward_to_gui
        else
            log "Button pressed! Starting headless scan..."
            run_headless_scan
        fi

        # Debounce - wait before polling again to let button release
        log "Waiting for button release..."
        sleep "$DEBOUNCE"

    elif [ "$button_state" = "error" ]; then
        log "Scanner not responding, waiting..."
        sleep 5
    fi
    # "busy" = GUI or another scan holds the lock; retry on the next tick.

    sleep "$poll_interval"
done
