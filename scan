#!/bin/bash
# scan - One-button scan from a Fujitsu ScanSnap to the configured destination.
#
# Captures one duplex batch, cleans up the pages, and delivers the result.
# Delivery mode is chosen automatically from the environment:
#   PAPERLESS_URL + PAPERLESS_TOKEN → upload via the Paperless-ngx API
#   FOLDER_DIR                      → write the PDF to that folder
# Color treatment defaults to auto (per-page color/grayscale detection).
#
# For the GUI workflow (single/multi page, color choice, NAPS2 target) see
# `scan-doc`.

set -e

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/scan-lib.sh"

DEVICE=$(resolve_device)

WORKDIR=$(mktemp -d)
trap 'rm -rf "$WORKDIR"' EXIT

FILENAME="${1:-scan-$(date '+%Y-%m-%d-%H%M%S')}"

with_scan_lock scan_pages "$DEVICE" "$WORKDIR/page" || {
    report_capture_failure $?
    exit 1
}

pages=("$WORKDIR"/page-*.tiff)
if [ ! -e "${pages[0]}" ] || [ ! -s "${pages[0]}" ]; then
    report_capture_failure 3
    exit 1
fi
echo "Scanned ${#pages[@]} page(s)"

apply_color_mode "${pages[@]}"
enhance_pages "${pages[@]}"
deliver_document "$FILENAME" "${pages[@]}"
