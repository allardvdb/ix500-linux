#!/bin/bash
# scan - One-button scan from the ScanSnap iX1300 to Paperless (or local OCR).
#
# Captures one duplex batch, cleans up the pages, and delivers the result.
# Delivery mode is chosen automatically from the environment:
#   PAPERLESS_URL + PAPERLESS_TOKEN → upload via the Paperless-ngx API
#   PAPERLESS_CONSUME_DIR           → write to the Paperless consume folder
#   (neither)                       → OCR locally into ~/Documents/scanner-inbox/
#
# For the GUI workflow (single/multi page, NAPS2 target) see `scan-doc`.

set -e

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/scan-lib.sh"

DEVICE=$(resolve_device)

WORKDIR=$(mktemp -d)
trap 'rm -rf "$WORKDIR"' EXIT

FILENAME="${1:-scan-$(date '+%Y-%m-%d-%H%M%S')}"

echo "Scanning (duplex, color, A4)..."
scan_batch "$DEVICE" "$WORKDIR/page"

pages=("$WORKDIR"/page-*.tiff)
if [ ! -e "${pages[0]}" ]; then
    echo "No pages scanned (feeder empty?)" >&2
    exit 1
fi
echo "Scanned ${#pages[@]} page(s)"

apply_color_detection "${pages[@]}"
enhance_pages "${pages[@]}"
deliver_paperless "$FILENAME" "${pages[@]}"
